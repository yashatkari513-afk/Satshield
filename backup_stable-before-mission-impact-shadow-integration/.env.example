# SATSHIELD AI - Environment Configuration Example

# Backend API URL (Frontend)
# Leave empty when using Vite reverse proxy / relative paths
VITE_API_BASE_URL=

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# Backend Email Dispatch Configuration (SMTP / Gmail App Password)
# Note: For Gmail, use an App Password (https://myaccount.google.com/apppasswords), NEVER your primary Google password.
# If these are left blank, SATSHIELD AI operates in high-fidelity simulated email dispatch mode for demonstrations.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-organization-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=mission-ops@satshield.ai
